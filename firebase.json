{
  "hosting": {
    "public": "website",
    "cleanUrls": true,
    "appAssociation": "AUTO",
    "rewrites": [
      {
        "source": "/join/**",
        "dynamicLinks": true
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ]
  }
}