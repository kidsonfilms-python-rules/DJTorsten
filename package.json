{
  "name": "djflame",
  "productName": "DJFlame",
  "version": "2021.4.11",
  "description": "DJFlame is a consumer Auto DJ Application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -ml",
    "dist-mac": "electron-builder --mac",
    "publish": "electron-builder -mwl --publish always"
  },
  "repository": "https://github.com/kidsonfilms-python-rules/DJTorsten",
  "keywords": [],
  "author": "DJFlame",
  "license": "LICENSE.md",
  "devDependencies": {
    "@octokit/core": "^3.3.1",
    "Console": "^1.1.0",
    "electron": "^12.0.2",
    "electron-builder": "^22.10.5",
    "http": "*",
    "node-fetch": "^2.6.1",
    "readline-sync": "^1.4.10",
    "request": "^2.88.2"
  },
  "testEnvironment": "node",
  "dependencies": {
    "electron-store": "^7.0.3",
    "electron-updater": "^4.3.9",
    "firebase": "^8.3.1",
    "fluent-ffmpeg": "^2.1.2",
    "node-mp3-player": "^1.0.3",
    "on-change": "^2.2.3",
    "play-sound": "^1.1.3",
    "tippy.js": "^6.3.1",
    "youtube-mp3-downloader": "^0.7.7",
    "yt-search": "^2.7.5",
    "ytdl-core": "^4.5.0"
  },
  "build": {
    "asar": false,
    "asarUnpack": [
      "assets/ffmpeg",
      "node-modules",
      "node-modules/youtube-mp3-downloader/"
    ],
    "appId": "com.djflame.djDestopClient",
    "files": [
      "assets/*",
      "css/*",
      "js/*",
      "music/*",
      "windows/*",
      "assets/**/*",
      "windows/**/*",
      "accountSettings.html",
      "ai.html",
      "createParty.html",
      "index.html",
      "LICENSE.md",
      "license.txt",
      "loading.html",
      "main.js",
      "package-lock.json",
      "package.json",
      "preload.js",
      "renderer.js",
      "sceneSettings.html",
      "signin.html"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kidsonfilms-python-rules",
        "repo": "DJFlame-Releases"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/appIcons/DJFlame Logo.icns"
    },
    "dmg": {
      "background": null,
      "icon": "assets/appIcons/DJFlame Logo.icns",
      "backgroundColor": "#202020",
      "window": {
        "width": "400",
        "height": "300"
      },
      "contents": [
        {
          "x": 100,
          "y": 100
        },
        {
          "x": 300,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "assets/appIcons/DJFlame Logo.ico",
      "license": "license.txt"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/DJFlame Logo.png"
    }
  }
}
