{
  "name": "djflame",
  "productName": "DJFlame",
  "version": "2021.7.2",
  "description": "DJFlame is a consumer Auto DJ Application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -mw",
    "dist-mac": "electron-builder --mac",
    "dist-linux": "electron-builder --linux",
    "publish": "electron-builder -mwl --publish always"
  },
  "repository": "https://github.com/kidsonfilms-python-rules/DJTorsten",
  "keywords": [],
  "author": "DJFlame",
  "license": "LICENSE.md",
  "devDependencies": {
    "Console": "^1.1.0",
    "electron": "^13.1.5",
    "electron-builder": "^22.11.7",
    "electron-notarize": "^1.0.0",
    "http": "*",
    "node-fetch": "^2.6.1",
    "readline-sync": "^1.4.10",
    "request": "^2.88.2"
  },
  "testEnvironment": "node",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.0.0",
    "electron-updater": "^4.3.9",
    "firebase": "^8.6.8",
    "fluent-ffmpeg": "^2.1.2",
    "jquery": "^3.6.0",
    "on-change": "^3.0.2",
    "play-sound": "^1.1.3",
    "youtube-mp3-downloader": "^0.7.7",
    "yt-search": "^2.9.0",
    "ytdl-core": "^4.8.3"
  },
  "build": {
    "asar": true,
    "appId": "com.djflame.djDestopClient",
    "files": [
      "assets/*",
      "css/*",
      "js/*",
      "music/*",
      "windows/*",
      "assets/**/*",
      "Canary/**/*",
      "windows/**/*",
      "accountSettings.html",
      "ai.html",
      "createParty.html",
      "index.html",
      "LICENSE.md",
      "license.txt",
      "loading.html",
      "main.js",
      "package-lock.json",
      "package.json",
      "preload.js",
      "renderer.js",
      "sceneSettings.html",
      "signin.html"
    ],
    "afterSign": "./build/afterSignHook.js",
    "directories": {
      "buildResources": "./build/resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kidsonfilms-python-rules",
        "repo": "DJFlame-Releases"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/appIcons/DJFlame Logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./build/resources/entitlements.mac.plist",
      "entitlementsInherit": "./build/resources/entitlements.mac.plist",
      "asarUnpack": "**/*.node"
    },
    "dmg": {
      "background": null,
      "icon": "assets/appIcons/DJFlame Logo.icns",
      "backgroundColor": "#202020",
      "window": {
        "width": "400",
        "height": "300"
      },
      "contents": [
        {
          "x": 100,
          "y": 100
        },
        {
          "x": 300,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/appIcons/DJFlame Logo.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "assets/appIcons/DJFlame Logo.ico",
      "license": "license.txt"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/DJFlame Logo.png"
    }
  }
}
