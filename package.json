{
  "name": "djflame",
  "productName": "DJFlame",
  "homepage": "https://djflame.tech",
  "version": "2021.12.31",
  "description": "DJFlame is a consumer Auto DJ Application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "mocha",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -mw",
    "dist-win": "electron-builder -w",
    "dist-mac": "electron-builder --mac",
    "dist-linux": "electron-builder --linux",
    "publish": "electron-builder -mwl --publish always"
  },
  "repository": "https://github.com/kidsonfilms-python-rules/DJTorsten",
  "keywords": [],
  "author": "DJFlame",
  "license": "LICENSE.md",
  "devDependencies": {
    "chalk": "^4.1.2",
    "Console": "^1.1.0",
    "electron": "^22.0.3",
    "electron-builder": "^22.14.5",
    "electron-notarize": "^1.1.1",
    "filesize": "^8.0.6",
    "minify": "^7.2.2",
    "mocha": "^9.1.3",
    "spectron": "^15.0.0",
    "uglify-js": "^3.14.5",
    "dotenv": "^10.0.0"
  },
  "testEnvironment": "node",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.0.1",
    "electron-updater": "^4.6.1",
    "firebase": "^8.9.1",
    "get-audio-duration": "^3.0.0",
    "jquery": "^3.6.0",
    "music-tempo": "^1.0.3",
    "play-sound": "^1.1.3",
    "solenolyrics": "^5.0.0",
    "web-audio-api": "^0.2.2",
    "yt-search": "^2.10.1"
  },
  "build": {
    "asar": true,
    "appId": "com.djflame.djDestopClient",
    "files": [
      "assets/*",
      "css/*",
      "js/*",
      "music/*",
      "windows/*",
      "assets/**/*",
      "Canary/**/*",
      "windows/**/*",
      "accountSettings.html",
      "ai.html",
      "createParty.html",
      "index.html",
      "LICENSE.md",
      "license.txt",
      "loading.html",
      "main.js",
      "package-lock.json",
      "package.json",
      "preload.js",
      "renderer.js",
      "sceneSettings.html",
      "signin.html"
    ],
    "afterSign": "./build/afterSignHook.js",
    "afterPack": "./build/afterPackHook.js",
    "directories": {
      "buildResources": "./build/resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kidsonfilms-python-rules",
        "repo": "DJFlame-Releases"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/appIcons/DJFlame Logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./build/resources/entitlements.mac.plist",
      "entitlementsInherit": "./build/resources/entitlements.mac.plist",
      "asarUnpack": "**/*.node"
    },
    "dmg": {
      "background": null,
      "icon": "assets/appIcons/DJFlame Logo.icns",
      "backgroundColor": "#202020",
      "window": {
        "width": "400",
        "height": "300"
      },
      "contents": [
        {
          "x": 100,
          "y": 100
        },
        {
          "x": 300,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/appIcons/DJFlame Logo.ico",
      "target": "nsis",
      "fileAssociations": [
        {
          "ext": "djf",
          "name": "DJFlame Mix",
          "icon": "DJFlame Logo.ico",
          "description": "An exported DJFlame Mix. Opened using DJFlame"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "assets/appIcons/DJFlame Logo.ico",
      "license": "license.txt",
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/DJFlame Logo.png",
      "fileAssociations": [
        {
          "ext": "djf",
          "name": "DJFlame Mix",
          "icon": "DJFlame Logo.ico"
        }
      ]
    }
  }
}
